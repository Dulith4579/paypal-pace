# ============================================================
# PayPal Pace – Environment Variables
# Copy to .env.local and fill in your own sandbox credentials.
# ============================================================

# PayPal Sandbox app (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID="your_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret"
# Same client ID, exposed to the browser for the PayPal JS SDK buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID="your_sandbox_client_id"

# Optional: webhook signature verification
# (https://developer.paypal.com/dashboard/webhooks/sandbox)
PAYPAL_WEBHOOK_ID=""

# Local AI (Ollama). Run: ollama pull gemma2:2b
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma2:2b"

# Optional: only used by the legacy /api/agent/rebalance endpoint
OPENAI_API_KEY=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"
